{
  "name": "reflection-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Read-only viewer for Reflection evidence bundles.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "demo-bundles": "vite-node scripts/make-demo-bundles.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.130.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reflection-projection": "workspace:*",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.7.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^26.1.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.3",
    "vite": "^7.2.4",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
