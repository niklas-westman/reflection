{
  "name": "reflection-projection",
  "version": "0.5.0",
  "description": "Neutral evidence projection and immutable bundles for Reflection: schemas, readiness, validity, decisions, release diffs, and a bundle reader and writer.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./node": {
      "import": "./dist/node/index.js",
      "types": "./dist/node/index.d.ts"
    },
    "./schema": "./schema/projection.v1.schema.json",
    "./schema/*": "./schema/*",
    "./viewer/*": "./viewer/*"
  },
  "keywords": [
    "reflection",
    "ui-validation",
    "design-systems",
    "evidence",
    "provider"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "schema",
    "docs",
    "viewer",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "schema": "pnpm build && node scripts/generate-json-schema.mjs",
    "prepack": "pnpm build && pnpm build:viewer",
    "smoke:package": "node scripts/smoke-package-install.mjs",
    "build:viewer": "pnpm --dir ../ui exec vite build --outDir ../projection/viewer --emptyOutDir"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
